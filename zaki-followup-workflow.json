    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst reminded = staticData.reminded || {};\nconst now = Date.now();\nfor (const item of $('Prepare Follow-up').all()) {\n  reminded[item.json.threadId] = now;\n}\nfor (const key of Object.keys(reminded)) {\n  if (now - reminded[key] > 30 * 24 * 3600 * 1000) delete reminded[key];\n}\nstaticData.reminded = reminded;\nreturn [{ json: { markedThreads: Object.keys(reminded).length } }];"
      },
