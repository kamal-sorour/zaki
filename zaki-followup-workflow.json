    },
    {
      "parameters": {
        "resource": "thread",
        "operation": "get",
        "threadId": "={{ $json.id }}",
        "simple": false,
        "options": {
          "returnOnlyMessages": true
        }
      },
      "id": "aecd246b-80b6-5c60-8ead-06a1eae420ea",
      "name": "Get Thread Messages",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst reminded = staticData.reminded || {};\nconst threads = {};\nfor (const item of $input.all()) {\n  const j = item.json;\n  const msgs = Array.isArray(j.messages) ? j.messages : [j];\n  for (const m of msgs) {\n    const tid = m.threadId || j.id;\n    if (!tid) continue;\n    if (!threads[tid]) threads[tid] = [];\n    threads[tid].push(m);\n  }\n}\nconst DAY = 24 * 3600 * 1000;\nconst now = Date.now();\nconst out = [];\nfor (const tid of Object.keys(threads)) {\n  if (reminded[tid]) continue;\n  const msgs = threads[tid].slice().sort((a, b) => Number(a.internalDate || 0) - Number(b.internalDate || 0));\n  const last = msgs[msgs.length - 1];\n  const labels = (last.labels || last.labelIds || []).map((l) => (typeof l === 'string' ? l : (l.id || l.name)));\n  if (!labels.includes('SENT') || labels.includes('DRAFT')) continue;\n  const ts = Number(last.internalDate || 0) || Date.parse(last.Date || '') || 0;\n  if (!ts) continue;\n  const ageDays = (now - ts) / DAY;\n  if (ageDays < 3 || ageDays > 14) continue;\n  const to = String(last.To || '');\n  if (!to || /no-?reply|noreply|do-?not-?reply|mailer-daemon/i.test(to)) continue;\n  const subject = String(last.Subject || '').trim();\n  out.push({ json: {\n    threadId: tid,\n    to: to,\n    subject: subject,\n    replySubject: /^re:/i.test(subject) ? subject : 'Re: ' + subject,\n    body: String(last.text || last.snippet || '').slice(0, 1500),\n    daysAgo: Math.floor(ageDays)\n  } });\n  if (out.length >= 5) break;\n}\nreturn out;"
      },
      "id": "4c93e5cb-9183-558a-8672-064bdd4b6bbf",
      "name": "Find Unanswered Threads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Original email I sent (subject: {{ $json.subject }}, to: {{ $json.to }}, {{ $json.daysAgo }} days ago):\n\n{{ $json.body }}\n\nWrite the follow-up email body now.",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You write short, polite follow-up emails for a busy professional whose earlier email got no reply. Rules: write in the SAME language and tone as the original email (Egyptian Arabic emails get polite Modern/Egyptian Arabic, English gets English). Maximum 4 sentences. Friendly, professional, not pushy. Reference the original topic briefly and end with a clear, easy next step. Output ONLY the email body text: no subject line, no explanations, no markdown."
            }
          ]
        }
      },
      "id": "09d8a1a4-0433-5e8c-b52f-feabd552cd3e",
      "name": "Write Follow-up Text",
