      },
      "id": "ed4deb05-0ca5-5358-b20f-9a6c3dbd0c96",
      "name": "Find Sent Threads",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail account"
        }
