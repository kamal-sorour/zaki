    {
      "parameters": {
        "jsCode": "const agent = $input.first().json;\nconst text = String(agent.output || '').trim();\nlet draftId = '';\nconst steps = agent.intermediateSteps || [];\nfor (const s of steps) {\n  const tool = String((s && s.action && s.action.tool) || '').toLowerCase();\n  if (tool.includes('create') && tool.includes('draft')) {\n    let obs = s.observation;\n    if (typeof obs !== 'string') obs = JSON.stringify(obs === undefined ? '' : obs);\n    const m = obs.match(/\"id\"\\s*:\\s*\"([^\"]+)\"/);\n    if (m) draftId = m[1];\n  }\n}\nreturn [{ json: { text, draftId } }];"
      },
